pkgname=pipewire-biglinux-config
pkgdesc="Pipewire configuration to better audio compatibility"
depends=('wireplumber>=0.5')
makedepends=('git')
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('GPL-3.0-or-later')
url="https://github.com/biglinux/pipewire-biglinux-config"
provides=("pipewire-biglinux-config-git")
replaces=('pipewire-biglinux-config-git')
source=("git+${url}.git")
md5sums=('SKIP')

package() {
    cp -r "${srcdir}/${pkgname}/${pkgname}/usr" "${pkgdir}/"
}
